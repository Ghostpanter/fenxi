# 复制为 .env 再启动。不要把 .env 提交到仓库。

# 朋友进入外面这一层时要填的口令。请换成一长串随机字符。
ACCESS_CODE=change-me-to-a-long-random-string

# 容器桌面（noVNC）的密码。经典 VNC 只认前 8 位，请用 8 位随机字符。
# 6080 默认只绑在本机，真正的保护是不要把桌面端口公开到网上。
NOVNC_PASSWORD=change12

# 同时在线的人数上限，每人占一个标签页。
MAX_TABS=8

# 同时让网页生成的人数。太大容易把一个账号打满。
MAX_PARALLEL=2

# 一个人多久不说话就先关掉他的标签页（毫秒）。对话记录还在，他回来会重新打开。
IDLE_CLOSE_MS=21600000

TZ=Asia/Shanghai

# 前面加了 HTTPS 反代时再设为 1，否则浏览器不会保存登录cookie。
# COOKIE_SECURE=1

# 前面有反代、需要相信 X-Forwarded-For 时再设为 1。
# TRUST_PROXY=1

# 正式环境不要设置。设为 1 会把口令写在首页上。
# DEMO_HINT=0
