# 复制为 .env 再启动。不要把 .env 提交到仓库。

# 登录态和对话副本放在这块盘上，不放进容器。换成外接硬盘的挂载点。
# 磁盘要用 ext4 这类 Linux 文件系统。exFAT / NTFS 存不了浏览器需要的权限。
# 多租户时，这块盘上会有 tenants.json 和 tenants/<id>/{profile,state}。
DATA_DIR=/mnt/fenxi

# 只跑一个租户时，设这一条就够了。会自动生成 id 为 default 的租户。
# 朋友进入外面这一层时要填的口令。请换成一长串随机字符。
ACCESS_CODE=change-me-to-a-long-random-string

# default 租户的容器桌面（noVNC）密码。经典 VNC 只认前 8 位，请用 8 位随机字符。
# 远程登录打开 http://服务器:8080/desktop ，地址可以改成公网 IP 或域名。
# 其他租户用自己的桌面密码，见 scripts/tenants.js。
NOVNC_PASSWORD=change12

# default 租户同时在线的人数上限，每人占一个标签页。其他租户在创建时单独设。
MAX_TABS=8

# 同时让网页生成的人数。太大容易把一个账号打满。
MAX_PARALLEL=2

# 一个人多久不说话就先关掉他的标签页（毫秒）。对话记录还在，他回来会重新打开。
IDLE_CLOSE_MS=21600000

TZ=Asia/Shanghai

# 前面加了 HTTPS 反代时再设为 1，否则浏览器不会保存登录cookie。
# COOKIE_SECURE=1

# 前面有反代、需要相信 X-Forwarded-For 时再设为 1。
# TRUST_PROXY=1

# 正式环境不要设置。设为 1 会把口令写在首页上。
# DEMO_HINT=0

# 多个租户请用下面的命令，不要把口令写进同一条 ACCESS_CODE：
#   node scripts/tenants.js create shop-a --code '长随机口令' --seats 8 --desktop-password 'abcd1234'
#   node scripts/tenants.js list
#   node scripts/tenants.js remove shop-a
# 容器里也可以：docker compose exec fenxi node scripts/tenants.js list
# 名单写在 $DATA_DIR/tenants.json（权限 600）。每个租户有自己的浏览器 profile 和席位。
